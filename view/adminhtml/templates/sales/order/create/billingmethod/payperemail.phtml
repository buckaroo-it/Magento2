<?php
/**
 * The radio button and its label are rendered by the core billing method form; this template only
 * provides the method's own fields, which core shows/hides through the "payment_form_<code>" element.
 * The fields start collapsed here and core's order.setPaymentMethod() expands them once the method
 * is selected, so the inline display is what it clears -- a stylesheet rule would not be reversible.
 */
$_code = $block->escapeHtml($block->getMethodCode());
$customerDetails = method_exists($block, 'getPPeCustomerDetails') ? $block->getPPeCustomerDetails() : null;
$mageInit = json_encode(['Buckaroo_Magento2/js/order/create/payperemail' => ['code' => $_code]]);
?>
<div id="payment_form_<?= $_code ?>"
     class="payment-method"
     style="display: none;"
     data-mage-init='<?= $block->escapeHtmlAttr($mageInit) ?>'>
    <fieldset class="admin__fieldset payment-method" id="payment_form_<?= $_code; ?>_fields">
        <legend class="admin__legend"><?= $block->escapeHtml(__('Billing address')) ?></legend>
        <div class="admin__field _required">
            <label class="label admin__field-label" for="buckaroo_magento2_payperemail_genderSelect">
                <span><?= $block->escapeHtml(__('Salutation:')); ?></span>
            </label>
            <div class="admin__field-control control">

                <select id="buckaroo_magento2_payperemail_genderSelect" name="payment[customer_gender]"
                        class="required-entry select admin__control-select">
                        <option value="1"><?= $block->escapeHtml(__('Mr.')); ?></option>
                        <option value="2"><?= $block->escapeHtml(__('Mrs.')); ?></option>
                        <option value="0"><?= $block->escapeHtml(__('They/them')); ?></option>
                        <option value="9"><?= $block->escapeHtml(__('Not Applicable')); ?></option>
                </select>
            </div>
        </div>

        <div class="admin__field _required">
            <label class="label admin__field-label" for="buckaroo_magento2_payperemail_BillingFirstName">
                <span><?= $block->escapeHtml(__('Billing First Name:')); ?></span>
            </label>
            <div class="admin__field-control control">
                <input id="buckaroo_magento2_payperemail_BillingFirstName"
                       class="input-text field"
                       type="text"
                       value="<?= $customerDetails ? $block->escapeHtml($customerDetails['firstName']) : ''; ?>"
                       data-bind="valueUpdate: 'keyup', attr: { 'data-validate': JSON.stringify({ 'required': true }) }"
                       name="payment[customer_billingFirstName]"
                >
            </div>
        </div>

        <div class="admin__field">
            <label class="label admin__field-label" for="buckaroo_magento2_payperemail_BillingMiddleName">
                <span><?= $block->escapeHtml(__('Billing Middle Name:')); ?></span>
            </label>
            <div class="admin__field-control control">
                <input id="buckaroo_magento2_payperemail_BillingMiddleName"
                       class="input-text field"
                       type="text"
                       value="<?= $customerDetails ? $block->escapeHtml($customerDetails['middleName']) : ''; ?>"
                       name="payment[customer_billingMiddleName]"
                >
            </div>
        </div>

        <div class="admin__field _required">
            <label class="label admin__field-label" for="buckaroo_magento2_payperemail_BillingLastName">
                <span><?= $block->escapeHtml(__('Billing Last Name:')); ?></span>
            </label>
            <div class="admin__field-control control">
                <input id="buckaroo_magento2_payperemail_BillingLastName"
                       class="input-text field"
                       type="text"
                       value="<?= $customerDetails ? $block->escapeHtml($customerDetails['lastName']) : ''; ?>"
                       data-bind="valueUpdate: 'keyup', attr: { 'data-validate': JSON.stringify({ 'required': true }) }"
                       name="payment[customer_billingLastName]"
                >
            </div>
        </div>

        <div class="admin__field _required">
            <label class="label admin__field-label" for="buckaroo_magento2_payperemail_Email">
                <span><?= $block->escapeHtml(__('Email:')); ?></span>
            </label>
            <div class="admin__field-control control">
                <input id="buckaroo_magento2_payperemail_Email"
                       class="input-text field"
                       type="text"
                       value="<?= $customerDetails ? $block->escapeHtml($customerDetails['email']) : ''; ?>"
                       data-bind="
                           valueUpdate: 'keyup',
                           attr: { 'data-validate': JSON.stringify({ 'required': true, 'validate-email': true }) }
                       "
                       name="payment[customer_email]"
                >
            </div>
        </div>

    </fieldset>
</div>
