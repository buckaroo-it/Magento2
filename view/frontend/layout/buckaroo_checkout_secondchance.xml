<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <meta name="robots" content="NOINDEX,NOFOLLOW"/>
    </head>

    <body>
        <referenceContainer name="content">
            <block class="Buckaroo\Magento2\Block\Checkout\SecondChance\Confirm" name="buckaroo_magento2.second_chance.confirm" template="Buckaroo_Magento2::checkout/second_chance/confirm.phtml" cacheable="false">
                <block class="Magento\Framework\View\Element\FormKey" name="buckaroo_magento2.second_chance.formkey" as="formkey"/>
            </block>
        </referenceContainer>
    </body>
</page>
