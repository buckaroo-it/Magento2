<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" layout="1column" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <css src="Buckaroo_Magento2::css/express-payments.css" />
        <script src="https://applepay.cdn-apple.com/jsapi/1.latest/apple-pay-sdk.js" src_type="url"/>
    </head>
    <body>
        <!-- The express payment buttons (Apple Pay, Google Pay, iDEAL Fast Checkout, PayPal Express)
             are added to the cart page via the shortcut_buttons_container event
             (see Observer/AddExpressShortcuts.php), not via layout XML. -->
        <referenceBlock name="checkout.cart.totals">
            <arguments>
                <argument name="jsLayout" xsi:type="array">
                    <item name="components" xsi:type="array">
                        <item name="block-totals" xsi:type="array">
                            <item name="children" xsi:type="array">
                                <item name="before_grandtotal" xsi:type="array">
                                    <item name="children" xsi:type="array">
                                        <item name="buckaroo-fee-order-level" xsi:type="array">
                                            <item name="component"  xsi:type="string">Buckaroo_Magento2/js/view/checkout/cart/totals/buckaroo_fee</item>
                                        </item>
                                        <item name="paid_gift" xsi:type="array">
                                            <item name="component" xsi:type="string">Buckaroo_Magento2/js/view/summary/totals</item>
                                            <item name="config" xsi:type="array">
                                                <item name="template" xsi:type="string">Buckaroo_Magento2/cart/totals/paid_gift</item>
                                            </item>
                                        </item>
                                   </item>
                                </item>
                            </item>
                        </item>
                    </item>
                </argument>
            </arguments>
        </referenceBlock>
    </body>
</page>
