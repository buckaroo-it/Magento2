/** @var string $block */
if ($block->canShowButton('Cart')): ?>
    <div id="google-pay-catalog-cart-view-component" data-bind="scope:'buckarooGooglepayCart'">
        <!-- ko template: getTemplate() --><!-- /ko -->

        <script>
            // Set up window.checkoutConfig before component loads (required for Magento core modules)
            (function() {
                var config = <?= /* @noEscape */ $block->getCheckoutConfig(); ?>;

                if (typeof window.checkoutConfig === 'undefined') {
                    window.checkoutConfig = config;
                    window.isCustomerLoggedIn = config.isCustomerLoggedIn || false;
                } else {
                    // Merge Google Pay config
                    if (config.payment && config.payment.buckaroo) {
                        if (!window.checkoutConfig.payment) window.checkoutConfig.payment = {};
                        if (!window.checkoutConfig.payment.buckaroo) window.checkoutConfig.payment.buckaroo = {};

                        Object.assign(window.checkoutConfig.payment.buckaroo, config.payment.buckaroo);
                    }
                }
            })();
        </script>

        <script type="text/x-magento-init">
            {
                "#google-pay-catalog-cart-view-component": {
                    "Magento_Ui/js/core/app": {
                        "components": {
                            "buckarooGooglepayCart": {
                                "component": "buckaroo/googlepay/catalog-cart-view",
                                "template": "Buckaroo_Magento2/checkout/cart/googlepay"
                            }
                        }
                    }
                }
            }
        </script>
    </div>

<?php endif; ?>
