<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:DataObject/etc/fieldset.xsd">
    <scope id="global">
        <fieldset id="sales_convert_quote">
            <field name="buckaroo_fee">
                <aspect name="to_order" />
            </field>
            <field name="base_buckaroo_fee">
                <aspect name="to_order" />
            </field>
            <field name="buckaroo_fee_tax_amount">
                <aspect name="to_order" />
            </field>
            <field name="buckaroo_fee_base_tax_amount">
                <aspect name="to_order" />
            </field>
            <field name="buckaroo_fee_incl_tax">
                <aspect name="to_order" />
            </field>
            <field name="base_buckaroo_fee_incl_tax">
                <aspect name="to_order" />
            </field>
        </fieldset>
        <fieldset id="sales_convert_quote_address">
            <field name="buckaroo_fee">
                <aspect name="to_order" />
            </field>
            <field name="base_buckaroo_fee">
                <aspect name="to_order" />
            </field>
            <field name="buckaroo_fee_tax_amount">
                <aspect name="to_order" />
            </field>
            <field name="buckaroo_fee_base_tax_amount">
                <aspect name="to_order" />
            </field>
            <field name="buckaroo_fee_incl_tax">
                <aspect name="to_order" />
            </field>
            <field name="base_buckaroo_fee_incl_tax">
                <aspect name="to_order" />
            </field>
        </fieldset>
    </scope>
</config>
