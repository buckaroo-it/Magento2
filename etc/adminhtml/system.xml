<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:module:Magento_Config:etc/system_file.xsd">
    <system>
        <tab id="buckaroo_module" sortOrder="998" translate="label" class="buckaroo-section">
            <label>Buckaroo</label>
        </tab>

        <section id="buckaroo_magento2" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>General Information</label>
            <tab>buckaroo_module</tab>
            <resource>Buckaroo_Magento2::configuration</resource>
            <include path="Buckaroo_Magento2::system/support.xml"/>
        </section>

        <section id="buckaroo_magento2_settings" translate="label" type="text" sortOrder="1" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Settings</label>
            <tab>buckaroo_module</tab>
            <resource>Buckaroo_Magento2::configuration</resource>
            <include path="Buckaroo_Magento2::system/account.xml"/>
        </section>

        <section id="buckaroo_magento2_payment_methods" translate="label" type="text" sortOrder="2" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Payment Methods</label>
            <tab>buckaroo_module</tab>
            <resource>Buckaroo_Magento2::configuration</resource>
            <include path="Buckaroo_Magento2::system/payment_methods_page.xml"/>
        </section>


        <section id="buckaroo_magento2_additional_features" translate="label" type="text" sortOrder="4" showInDefault="1" showInWebsite="1" showInStore="1">
            <label>Additional Features</label>
            <tab>buckaroo_module</tab>
            <resource>Buckaroo_Magento2::configuration</resource>
            <include path="Buckaroo_Magento2::system/additional_features.xml"/>
        </section>

        <section id="payment">
            <include path="Buckaroo_Magento2::system/payment_methods.xml"/>
        </section>
    </system>
</config>
